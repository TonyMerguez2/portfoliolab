# Les réglages du site en ligne. À copier dans /etc/novac/novac.env,
# à remplir, puis à protéger :
#
#   sudo install -d -m 750 /etc/novac
#   sudo cp novac.env.exemple /etc/novac/novac.env
#   sudo chown root:novac /etc/novac/novac.env && sudo chmod 640 /etc/novac/novac.env
#
# ⚠️ Ce fichier porte trois secrets. Il ne va pas dans git — il n'est pas dans le dépôt
# ailleurs que sous forme d'exemple, et c'est voulu.

# ── Ce qui dit au serveur qu'il est en ligne ────────────────────────────────
#
# ⚠️ Sans cette ligne, la garde de la clé de session ne se déclenche pas et le
# site démarrerait avec la clé du dépôt. Elle n'est pas décorative.
NOVAC_ENV=production

# ── La clé qui signe les sessions ───────────────────────────────────────────
#
# Tirez-la, ne l'inventez pas :   openssl rand -hex 32
#
# ⚠️ La changer déconnecte tout le monde une fois. À poser au premier
# démarrage, puis à ne plus toucher.
NOVAC_JWT_SECRET=

# ── La porte de l'alpha fermée ──────────────────────────────────────────────
#
# Le code que vous donnez aux invités. ⚠️ S'il est vide, la porte n'existe pas
# et le site est public : c'est le seul endroit qui décide.
NOVAC_ACCES_MOT_DE_PASSE=

# Signe le cookie de la porte.   openssl rand -hex 32
NOVAC_ACCES_SECRET=

# ── Réglages accessoires ────────────────────────────────────────────────────
#
# Où Next va chercher l'API. La valeur par défaut convient tant que les deux
# tournent sur la même machine.
API_INTERNE=http://127.0.0.1:8000

# Utile seulement si l'API venait à être servie sur son propre sous-domaine.
# ORIGINES_PUBLIQUES=https://novac.xyz,https://www.novac.xyz

NODE_ENV=production
